# Copy to .env and fill in; never commit .env.
# API keys and database URLs live here. Model IDs, temperature and effort are pinned in the
# committed evals/model_check/models.yaml (Task 4 decision, 26 Nov 2026).
GOOGLE_API_KEY=
GROQ_API_KEY=

# Local Docker Postgres (docker-compose.yml). Throwaway local credentials, not secrets.
# A real Neon URL contains a password: it goes only in .env or Render's env, never here.
DATABASE_URL=postgresql://support:support@localhost:5433/support_dev
TEST_DATABASE_URL=postgresql://support:support@localhost:5433/support_test
